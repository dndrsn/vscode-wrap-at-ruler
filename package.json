{
  "name": "wrap-at-ruler",
  "displayName": "Wrap At Ruler",
  "description": "Wraps selected text at the ruler",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:extension.wrapAtRuler"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.wrapAtRuler",
        "title": "Wrap Text at Ruler"
      }
    ],
    "keybindings": [
      {
        "command": "extension.wrapAtRuler",
        "key": "shift+ctrl+w",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "extension.wrapAtRuler",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint",
    "lint": "eslint .",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "eslint": "^8.27.0",
    "glob": "^8.0.3",
    "vscode-test": "^1.6.1"
  },
  "packageManager": "pnpm@10.6.5"
}
