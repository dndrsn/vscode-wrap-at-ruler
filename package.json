{
  "name": "wrap-at-ruler",
  "displayName": "Wrap at Ruler",
  "description": "Wraps selected text at the ruler",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:extension.wrapAtRuler"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.wrapAtRuler",
        "title": "Wrap Text at Ruler"
      }
    ],
    "keybindings": [
      {
        "command": "extension.wrapAtRuler",
        "key": "shift+ctrl+w",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Wrap at Ruler",
      "properties": {
        "wrapAtRuler.characterBuffer": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Number of characters before ruler to wrap"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint",
    "lint": "eslint .",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "eslint": "^8.27.0",
    "eslint-plugin-n": "^17.16.2",
    "glob": "^8.0.3",
    "globals": "^16.0.0",
    "vscode-test": "^1.6.1"
  },
  "packageManager": "pnpm@10.6.5"
}
