{
  "name": "wrap-at-ruler",
  "displayName": "Wrap at Ruler",
  "description": "Wraps selected text at the ruler",
  "version": "0.0.1",
  "publisher": "dndrsn",
  "license": "MIT",
  "repository": "https://github.com/dndrsn/vscode-wrap-at-ruler",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Formatters"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.wrapAtRuler",
        "title": "Wrap Text at Ruler"
      }
    ],
    "keybindings": [
      {
        "command": "extension.wrapAtRuler",
        "key": "shift+ctrl+w",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Wrap at Ruler",
      "properties": {
        "wrapAtRuler.characterBuffer": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Number of characters before ruler to wrap at."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run lint",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/vscode": "^1.98.0",
    "eslint": "^9.23.0",
    "eslint-plugin-n": "^17.16.2",
    "glob": "^11.0.1",
    "globals": "^16.0.0"
  },
  "packageManager": "pnpm@10.6.5"
}
